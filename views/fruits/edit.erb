<% kategorier = ["Stenfrukt", "Bär", "Citrusfrukter", "Tropisk", "Annat"] %>

<h2>Uppdatera frukt</h2>

<h3> <%= @fruits["name"]%> </h3>

<form action="/fruits/edit" method="post">
    <input hidden type=text name="id" value="<%= @fruits["id"]%>"> 
    Namn:
    <input type=text name="name" value="<%= @fruits["name"] %>">
    <br>
    Smak(?/10): 
    <input type="text" name="taste" value="<%= @fruits["tastiness"] %>">
    Beskrivning:
    <input type="text" name="desc" value="<%= @fruits["description"] %>">
    Ursprungsland:
    <input type="text" name="origin" value="<%= @fruits["origin"] %>">
    Kategori:


    <select name="categories_id">
        <% @categories.each do |kat|%>
        <option value="<%= kat["id"]%>"> <%= kat["name"]%> </option>
        <%end%>
    </select>



    <input type="submit" value="Uppdatera frukt">
</form>